{
  "name": "vulcan",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Vulcan",
    "email": "vulcan@localhost"
  },
  "homepage": "https://github.com/dwhite-sys/Vulcan",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run runtime:hash && npm run test:packaging && vite build && electron-builder --publish never",
    "electron:preview": "vite build && cross-env NODE_ENV=production electron .",
    "test:transcript": "node --experimental-strip-types scripts/transcript-regression.ts",
    "test:sidebar": "node --experimental-strip-types scripts/sidebar-ordering-regression.ts",
    "test:tool-icons": "node scripts/tool-icon-regression.mjs",
    "test:visualizations": "node scripts/visualization-regression.mjs",
    "test:servers": "node --experimental-strip-types scripts/server-switch-regression.ts",
    "test:server-passwords": "node --experimental-strip-types --experimental-vm-modules scripts/server-password-regression.ts",
    "test:skill-visibility": "node --experimental-strip-types --experimental-vm-modules scripts/skill-visibility-regression.ts",
    "test:server-transport": "node --experimental-strip-types --experimental-vm-modules scripts/general-ws-regression.ts",
    "test:terminals": "node scripts/terminal-regression.mjs",
    "test:scroll": "node --experimental-strip-types scripts/transcript-scroll-regression.ts",
    "test:chat-search": "node --experimental-strip-types scripts/chat-topic-search-regression.ts",
    "test:library-dashboards": "node scripts/library-dashboard-regression.mjs",
    "test:quotes": "node --experimental-strip-types scripts/quote-regression.ts",
    "test:preview": "node scripts/preview-regression.mjs",
    "test:hydration": "node scripts/server-hydration-regression.mjs",
    "test:markdown-defense": "node --experimental-strip-types scripts/markdown-defense-regression.ts",
    "test:virtualization": "node --experimental-strip-types scripts/transcript-virtualization-regression.ts",
    "test:message-edit": "node --experimental-strip-types scripts/message-edit-regression.ts",
    "test:network-pov": "node --experimental-strip-types scripts/network-pov-regression.ts",
    "test:provider-editing-mode": "node --experimental-strip-types scripts/provider-editing-mode-regression.ts",
    "test:etna-multiserver": "node --experimental-strip-types scripts/etna-multiserver-regression.ts",
    "test:client-owned-network": "node --experimental-strip-types scripts/client-owned-network-regression.ts",
    "test:etna-switch": "node scripts/etna-switch-regression.mjs",
    "test:connection-lifecycle": "node scripts/connection-lifecycle-regression.mjs",
    "test:etna-playwright": "node scripts/etna-playwright-regression.mjs",
    "test:host-network": "node scripts/host-network-regression.mjs",
    "test:workspace-assets": "node --experimental-strip-types scripts/workspace-assets-regression.ts",
    "test:network-profile-scope": "node scripts/network-profile-scope-regression.mjs",
    "test:renderer-startup": "node scripts/renderer-startup-regression.mjs",
    "test:harness-trust": "node --experimental-strip-types scripts/harness-trust-regression.ts",
    "test:settings-persistence": "node scripts/settings-persistence-regression.mjs",
    "test:settings-ui": "node scripts/settings-ui-regression.mjs",
    "test:tool-semantic-cache": "node scripts/tool-semantic-cache-regression.mjs",
    "test:tool-semantic-document": "node --experimental-strip-types scripts/tool-semantic-document-regression.ts",
    "test:semantic-cache-store": "node scripts/semantic-cache-store-regression.mjs",
    "test:transcript-search": "node --experimental-strip-types scripts/transcript-search-regression.ts",
    "test:branching": "node --experimental-strip-types scripts/branching-regression.ts",
    "test:branch-ui": "node --experimental-strip-types scripts/branch-ui-regression.ts",
    "test:topbar-chat-title": "node --experimental-strip-types scripts/topbar-chat-title-regression.ts",
    "test:etna-health": "node scripts/etna-health-boundary-regression.mjs",
    "test:etna-auto-recovery": "node --experimental-strip-types scripts/etna-auto-recovery-regression.ts",
    "test:workspace-image-viewer": "node --experimental-strip-types scripts/workspace-image-viewer-regression.ts",
    "test:design-beta": "node --experimental-strip-types scripts/design-beta-regression.ts",
    "test:design-tools": "node --experimental-strip-types scripts/design-tools-regression.ts",
    "test:model-vision": "node --experimental-strip-types scripts/model-vision-regression.ts",
    "test:design-live-surface": "node --experimental-strip-types scripts/design-live-surface-regression.ts",
    "test:design-proxy": "node --experimental-strip-types scripts/design-proxy-regression.ts",
    "test:tool-repeat-guard": "node --experimental-strip-types scripts/tool-repeat-guard-regression.ts",
    "runtime:hash": "node scripts/generate-runtime-hash.mjs",
    "test:packaging": "node scripts/packaging-regression.mjs"
  },
  "build": {
    "appId": "com.vulcan.app",
    "productName": "Vulcan",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "Name": "Vulcan",
          "Comment": "AI harness with local server and workspaces",
          "StartupWMClass": "Vulcan",
          "Categories": "Development;Utility;"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "icon": "build/icon.png",
    "artifactName": "Vulcan-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vulcan"
    },
    "dmg": {
      "title": "Vulcan ${version}"
    },
    "extraResources": [
      {
        "from": "../vulcan",
        "to": "vulcan-server",
        "filter": [
          "**/*",
          "!tests/**/*",
          "!**/__pycache__/**/*",
          "!**/*.pyc",
          "!SERVER_MANAGEMENT_UI_BACKLOG.md",
          "!**/.pytest_cache/**/*",
          "!**/.mypy_cache/**/*"
        ]
      },
      {
        "from": "../install.sh",
        "to": "install.sh"
      },
      {
        "from": "../install.ps1",
        "to": "install.ps1"
      },
      {
        "from": "build/server-payload.sha256",
        "to": "server-payload.sha256"
      },
      {
        "from": "build/icon.png",
        "to": "vulcan-icon.png"
      }
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.33.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-hook-form": "7.55.0",
    "react-markdown": "^10.1.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "2.15.2",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2",
    "@tanstack/react-virtual": "3.14.10",
    "react-zoom-pan-pinch": "4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "4.1.12",
    "vite": "^6.3.5",
    "wait-on": "^9.0.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "description": "AI harness with local server and workspaces.",
  "engines": {
    "node": ">=22.12.0"
  }
}
